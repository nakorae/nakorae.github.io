---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 頑張ってastroとmdの両方に対応させる
const { frontmatter, title, description } = Astro.props;
const pageTitle = frontmatter?.title || title || "";
const pageDescription = frontmatter?.description || description || "no description";
const publishedDate = frontmatter?.published;
const editedDate = frontmatter?.edited;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- SEO (?) -->
		<title>{pageTitle} - nakorae's homepage</title>
		<meta name="description" content={pageDescription} />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<Header />
		<main>
			<h1>{pageTitle}</h1>
			<div>
				{publishedDate && <span>公開日: {publishedDate}/</span>}
				{editedDate && <span>更新日: {editedDate}</span>}
			</div>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	/* html, */
	main {
		padding: 5% 5%;
		width: 100%;
		height: 100%;
	}
	body {
		width: 100%
	}
</style>
